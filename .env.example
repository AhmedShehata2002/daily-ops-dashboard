# Daily Ops Dashboard — Environment Variables
# Copy this file to .env for local development (never commit .env)
# All of these are set as GitHub Secrets in your repo for production.

# ── Google Calendar ──────────────────────────────────────────────────────────
# Restricted API key (Calendar API read-only)
GCAL_API_KEY=your_google_calendar_api_key_here

# Calendar ID (usually your Google account email or the calendar's ID)
GCAL_CALENDAR_ID=your_calendar_id_here

# ── Ellie Task Manager ───────────────────────────────────────────────────────
# Your personal MCP URL from: Ellie → Settings → Power Features → MCP Server
ELLIE_MCP_URL=https://app.ellieplanner.com/api/mcp/your_token_here

# API key generated in the same Power Features panel
ELLIE_API_KEY=your_ellie_api_key_here

# ── GitHub Actions ───────────────────────────────────────────────────────────
# Personal Access Token with repo + workflow scopes (for pushing workflow files)
# Not needed for regular sync — only for pushing changes to .github/workflows/
BOT_PAT=ghp_your_personal_access_token_here

# ── Whoop (Work in Progress) ─────────────────────────────────────────────────
# WHOOP_CLIENT_ID=your_whoop_client_id
# WHOOP_CLIENT_SECRET=your_whoop_client_secret
# WHOOP_REFRESH_TOKEN=your_whoop_refresh_token
